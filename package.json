    ]
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "expo": "~58.1.0",
    "expo-brightness": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-router": "~58.0.33",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
